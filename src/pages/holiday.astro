---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import DesignPackageCard from '../components/DesignPackageCard.astro';
import packageData from '../data/design-packages.json';
import { readDesignPackages } from '../lib/design-packages.mjs';

const projects = await getCollection('projects');
const packages = readDesignPackages(packageData, projects.map((project) => project.id));
const featuredProjects = [...projects].sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.title.localeCompare(b.data.title)).slice(0, 3);
---
<BaseLayout title="Holiday & Interior Design | Revive Studios" description="Explore holiday decorating, front porch styling, and interior design with Revive Studios in Alpine, Utah. Browse our past interiors and plan your next project.">
  <section class="bg-cream-dark px-6 py-12 md:px-12 md:py-20">
    <div class="mx-auto grid max-w-7xl items-center gap-10 md:grid-cols-2 md:gap-16">
      <div>
        <p class="mb-5 text-xs font-medium uppercase tracking-[0.2em] text-olive">Revive Studios · Holiday design</p>
        <h1 class="mb-6 font-serif text-5xl font-light leading-[1.05] md:text-6xl lg:text-7xl">A home ready<br />for the season.</h1>
        <p class="mb-8 max-w-lg text-lg leading-relaxed text-charcoal-light">From festive interiors to a welcoming front porch, thoughtful details make the season feel at home.</p>
        <div class="flex flex-wrap gap-4">
          <a href="#design-options" class="inline-flex min-h-11 items-center bg-olive px-6 py-3.5 text-xs font-medium uppercase tracking-[0.15em] text-white transition-colors hover:bg-olive-dark focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-olive">Explore design options</a>
          <a href="#past-work" class="inline-flex min-h-11 items-center px-2 py-3 text-sm text-olive underline underline-offset-4 hover:text-olive-dark">See our work</a>
        </div>
      </div>
      <figure>
        <img src="/images/holiday-decor.jpg" alt="Holiday mantel with evergreen garland, red stockings, and candles" width="1122" height="1402" class="aspect-[4/5] max-h-[660px] w-full object-cover" fetchpriority="high" />
        <figcaption class="mt-3 text-sm text-charcoal-light">Holiday &amp; front porch decor by Revive Studios</figcaption>
      </figure>
    </div>
  </section>

  <section id="design-options" class="scroll-mt-24 px-6 py-20 md:px-12 md:py-28" aria-labelledby="design-options-title">
    <div class="mx-auto max-w-7xl">
      <div class="mb-10 max-w-2xl">
        <p class="mb-3 text-xs font-medium uppercase tracking-[0.2em] text-olive">Made for your space</p>
        <h2 id="design-options-title" class="mb-5 font-serif text-4xl font-light md:text-5xl">Holiday details. Everyday living.</h2>
        <p class="text-lg leading-relaxed text-charcoal-light">Explore seasonal decorating alongside our interior design services. Each project starts with your space and what you have in mind.</p>
      </div>
      {packages.length > 0 ? (
        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
          {packages.map((item) => <DesignPackageCard package={item} projects={projects} />)}
        </div>
      ) : (
        <div class="grid gap-8 border-y border-warm-gray py-10 md:grid-cols-2 md:gap-16">
          <div>
            <h3 class="mb-4 font-serif text-3xl font-light">Holiday &amp; front porch decor</h3>
            <p class="mb-5 leading-relaxed text-charcoal-light">Full-service curation and installation of seasonal and year-round decor. We design and style welcoming holiday spaces, from festive home decor to thoughtfully arranged front porch elements.</p>
            <a href="/contact" class="inline-flex min-h-11 items-center text-olive underline underline-offset-4 hover:text-olive-dark">Tell us about your holiday project</a>
          </div>
          <div>
            <h3 class="mb-4 font-serif text-3xl font-light">Interior design, your way</h3>
            <p class="mb-5 leading-relaxed text-charcoal-light">Design consultations, space planning, styling, and thoughtful renovations. Browse our services, then tell us what you would like to create.</p>
            <a href="/services" class="inline-flex min-h-11 items-center text-olive underline underline-offset-4 hover:text-olive-dark">Explore interior design services</a>
          </div>
        </div>
      )}
    </div>
  </section>

  <section id="past-work" class="scroll-mt-24 bg-cream-dark px-6 py-20 md:px-12 md:py-28" aria-labelledby="past-work-title">
    <div class="mx-auto max-w-7xl">
      <div class="mb-10 flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <div class="max-w-2xl">
          <p class="mb-3 text-xs font-medium uppercase tracking-[0.2em] text-olive">From our portfolio</p>
          <h2 id="past-work-title" class="mb-4 font-serif text-4xl font-light md:text-5xl">A look at our interiors.</h2>
          <p class="leading-relaxed text-charcoal-light">Past interior design projects, each with its own point of view. Explore the spaces and details behind our work.</p>
        </div>
        <a href="/portfolio/all" class="inline-flex min-h-11 flex-shrink-0 items-center text-olive underline underline-offset-4 hover:text-olive-dark">View all projects</a>
      </div>
      <div class="grid gap-8 md:grid-cols-3">
        {featuredProjects.map((project) => <a href={`/portfolio/${project.id}`} class="group block focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-olive">
          <div class="mb-5 overflow-hidden"><img src={project.data.hero} alt={project.data.title} class="aspect-[4/3] w-full object-cover transition-transform duration-300 motion-safe:group-hover:scale-105" loading="lazy" /></div>
          <h3 class="mb-1 font-serif text-2xl font-light">{project.data.title}</h3>
          <p class="text-sm text-charcoal-light">{project.data.location}</p>
        </a>)}
      </div>
    </div>
  </section>

  <section class="bg-olive px-6 py-20 text-white md:px-12 md:py-28" aria-labelledby="holiday-contact-title">
    <div class="mx-auto max-w-3xl text-center">
      <h2 id="holiday-contact-title" class="mb-5 font-serif text-4xl font-light md:text-5xl">Let's make it feel like home.</h2>
      <p class="mb-8 text-lg leading-relaxed text-white/90">Tell us about your space and the season you have in mind.</p>
      <a href="/contact" class="inline-flex min-h-11 items-center border border-white px-8 py-3.5 text-xs font-medium uppercase tracking-[0.15em] transition-colors hover:bg-white hover:text-olive focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white">Start a conversation</a>
    </div>
  </section>
</BaseLayout>
